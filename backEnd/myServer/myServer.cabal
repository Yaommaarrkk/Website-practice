cabal-version:       2.2

name:                myServer
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/githubuser/myServer#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              姚子謙
maintainer:          yaomark0216@gmail.com
copyright:           2025 姚子謙
category:            Web
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable myServer
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    Haskell2010
  other-modules:
    API
    Request
    Respond
    Error
    General
    Http
    Cut.MakeCuts
    Cut.MakeCuts_type
    MyLibrary.Environment
    MyLibrary.Time
    MyLibrary.Threads
  build-depends: 
    base >=4.7 && <5,
    bytestring,
    filepath,
    directory,
    network,
    split,
    containers,
    text,
    uri-encode,
    aeson,
    transformers >=0.5,
    process >=1.6,
    time,
    regex-tdfa,
    mtl,
    stm,
    async,
    Win32

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -threaded
